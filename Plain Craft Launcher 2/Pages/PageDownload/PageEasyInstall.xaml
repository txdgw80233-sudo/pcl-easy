<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageEasyInstall"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,15,25,25">
            <TextBlock x:Name="LabTitle" Text="想玩点什么？" FontSize="25" Margin="0,10,0,6" />
            <TextBlock Text="选一个就行，剩下的交给我。" Opacity="0.65" Margin="0,0,0,18" />

            <local:MyCard x:Name="CardMode" Title="第一步 · 选择玩法" Margin="0,0,0,15">
                <StackPanel Margin="25,42,25,18">
                    <local:MyListItem x:Name="ItemVanilla" Type="RadioBox" Height="58" Margin="0,0,0,8"
                                      Title="玩原版" Info="官方原汁原味，最稳定，和朋友联机最省事"
                                      Logo="m351.9,801.7c-8.6,0-17-3-23.7-8.4L18.9,614.7c-12.5-7.2-19.7-20.5-18.8-34.9V221c-.7-15,6.6-28.8,19.2-36L325.2,8.3c6.6-5.3,15.1-8.3,24-8.3s17.3,2.9,23.9,8.2l308.3,178c.2.1.5.3.8.5h0c12,6.7,19.4,19.8,19.4,34.1,0,13.9-7.1,26-18.7,32.5l-290.1,167.5v276l234-135.1v-168.9c0-20.8,17-37.8,37.8-37.8s37.8,17,37.8,37.8v191.7c0,16.4-10.9,31.2-26.5,36.1l-299.4,172.8c-6.7,5.4-15.1,8.3-23.7,8.3h-.9Zm-34.8-101.9v-276l-241.4-139.4v276l241.4,139.4Zm35.3-342.8l236.8-136.7-240-138.6L112.4,218.3l240,138.6Z"
                                      Click="Mode_Click" />
                    <local:MyListItem x:Name="ItemModded" Type="RadioBox" Height="58"
                                      Title="加模组" Info="想装 Mod、光影、整合包，选这个"
                                      Logo="M789.504 912.896h-195.072a35.328 35.328 0 0 1-34.816-35.328v-77.312a39.936 39.936 0 0 0-40.448-39.936H481.28a40.448 40.448 0 0 0-40.448 39.936v77.312a34.816 34.816 0 0 1-34.816 35.328H204.8a41.984 41.984 0 0 1-40.448-42.496v-200.192a35.328 35.328 0 0 1 35.328-35.328h72.704a39.936 39.936 0 0 0 39.936-39.936v-37.888a39.936 39.936 0 0 0-39.936-40.448H199.68a35.328 35.328 0 0 1-35.328-35.328V287.744A41.984 41.984 0 0 1 204.8 245.76h176.64v-32.768a102.4 102.4 0 0 1 102.4-102.4h33.792a102.4 102.4 0 0 1 102.4 102.4v32.768h170.496a41.984 41.984 0 0 1 41.984 41.984V460.8h28.672a102.4 102.4 0 0 1 102.4 102.4v33.792a102.4 102.4 0 0 1-102.4 102.4h-28.672V870.4a41.984 41.984 0 0 1-43.008 42.496z m-159.744-70.144h131.584V665.6a34.304 34.304 0 0 1 34.816-34.816h64a31.744 31.744 0 0 0 31.744-31.744V563.2a31.744 31.744 0 0 0-31.744-31.744h-64a34.816 34.816 0 0 1-34.816-35.328V316.416h-177.152a35.328 35.328 0 0 1-35.328-35.328V212.992a31.744 31.744 0 0 0-31.744-31.744h-33.792a31.744 31.744 0 0 0-31.744 31.744v68.096a35.328 35.328 0 0 1-34.816 35.328H234.496v130.048h37.888a110.592 110.592 0 0 1 110.08 110.592v37.888a110.592 110.592 0 0 1-110.08 110.592h-37.888v137.216h136.192v-42.496a110.592 110.592 0 0 1 110.592-110.08h37.888a110.592 110.592 0 0 1 110.592 110.08z"
                                      Click="Mode_Click" />
                    <StackPanel Orientation="Horizontal" Margin="6,14,0,0">
                        <TextBlock Text="游戏版本" VerticalAlignment="Center" Opacity="0.65" Margin="0,0,12,0" />
                        <local:MyComboBox x:Name="ComboVersion" Width="190" HorizontalAlignment="Left"
                                          SelectionChanged="ComboVersion_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardLoader" Title="第二步 · 选择模组加载器" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="25,42,25,18">
                    <local:MyListItem x:Name="ItemFabric" Type="RadioBox" Height="58" Margin="0,0,0,8"
                                      Title="Fabric（推荐）" Info="启动快、更新快，绝大多数新 Mod 都支持"
                                      Click="Loader_Click" />
                    <local:MyListItem x:Name="ItemForge" Type="RadioBox" Height="58"
                                      Title="Forge" Info="老牌加载器，很多整合包仍在用"
                                      Click="Loader_Click" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="最后一步 · 开始安装">
                <StackPanel Margin="25,42,25,22">
                    <TextBlock x:Name="LabSummary" Text="正在获取版本列表……" Margin="0,0,0,14" TextWrapping="Wrap" />
                    <local:MyButton x:Name="BtnInstall" Text=" 开始安装" ColorType="Highlight" MinWidth="200" Padding="15,8"
                                    HorizontalAlignment="Left" Click="BtnInstall_Click" />
                    <TextBlock x:Name="LabStatus" Opacity="0.6" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
